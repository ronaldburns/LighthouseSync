// The dashboard exe's icon (lhs/make_icon.py) and version (lhs/stamp.py, for releases)
#include <winver.h>

#ifdef LHS_STAMPED
#include "lhs_build.h"
#endif
#ifndef LHS_VERSION
#define LHS_VERSION "local build"
#define LHS_VERSION_NUM 0,0,0,0
#endif

1 ICON "lhs\\icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION LHS_VERSION_NUM
PRODUCTVERSION LHS_VERSION_NUM
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "LighthouseSync"
      VALUE "FileDescription", "LighthouseSync"
      VALUE "FileVersion", LHS_VERSION
      VALUE "InternalName", "QuestLHSync"
      VALUE "LegalCopyright", "Copyright (c) 2026 CreoleVR and LighthouseSync contributors, MIT License"
      VALUE "OriginalFilename", "QuestLHSync.exe"
      VALUE "ProductName", "LighthouseSync"
      VALUE "ProductVersion", LHS_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
